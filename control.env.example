################################################################################
# Lagran CDN 控制面（Control Plane）环境变量
# 应用：apps/control  → 二进制 lagran-control
#
# 使用方式：
#   cp control.env.example control.env
#   set -a && source control.env && set +a
#   ./lagran-control
# systemd 使用 EnvironmentFile=/etc/lagran/control.env。
#
# 约定：
#   - 未设置时使用代码默认值；
#   - 类型为 bool 的值接受 1/0、true/false、yes/no、on/off；
#   - “代码默认”以当前代码为准，生产环境请显式覆盖安全相关项。
################################################################################

# =============================================================================
# 1. 监听与对外地址
# =============================================================================

# 控制面 HTTP 监听地址。优先于 CONTROL_HOST + CONTROL_PORT。
# 默认：0.0.0.0:8080
CONTROL_BIND=0.0.0.0:8080

# 旧式拆分配置，仅在 CONTROL_BIND 为空时生效。
# CONTROL_HOST=0.0.0.0
# CONTROL_PORT=8080

# 控制面公网根地址（不带末尾 /），用于生成节点安装命令中的 CONTROL_URL。
# 不用于 Edge → Control 的回调；该回调地址是节点自己的 AGENT_URL。
# 留空时按请求 Host 推断；生产建议填写 HTTPS 地址。
# 示例：https://control.example.com
CONTROL_PUBLIC_URL=


# =============================================================================
# 2. PostgreSQL
# =============================================================================

# 必填。sqlx PostgreSQL 连接串。
# 生产建议独立账号、强密码；远程数据库使用 ?sslmode=require。
# 默认：postgres://lagran:lagran@127.0.0.1:5432/lagran
DATABASE_URL=postgres://lagran:lagran@127.0.0.1:5432/lagran

# 每个 control 进程的连接池上限，代码钳制 2–200。
# 多副本总连接数 = 副本数 × max，不能超过 PostgreSQL max_connections。
# 默认：20
DATABASE_MAX_CONNECTIONS=20

# 每个进程保持的空闲连接数，不能大于 max。
# 默认：2
DATABASE_MIN_CONNECTIONS=2

# 获取连接超时（秒），代码钳制 1–60。
# 默认：5
DATABASE_ACQUIRE_TIMEOUT_SECS=5

# 启动时自动执行 sqlx migrations；生产请先备份数据库。


# =============================================================================
# 3. Redis（可选，P1 共享状态）
# =============================================================================

# 留空：登录限流、验证码、会话缓存、配置缓存、分布式锁和实时统计
# 自动回退到进程内状态 / PostgreSQL。
# 支持 redis://、rediss://（TLS）、带 ACL 密码的 URL。
# 示例：redis://:password@127.0.0.1:6379/0
# 生产建议内网访问、密码/ACL；跨主机启用 TLS。
REDIS_URL=

# Redis 会话缓存 TTL（秒），代码钳制 5–300。
# 用户角色、密码、启用状态变更时会主动失效。
# 默认：30
REDIS_SESSION_TTL_SECS=30

# 边缘批量配置的进程内缓存 TTL（秒），代码钳制 1–60。
# 配置变更最多延迟该 TTL 生效；边缘默认 15 秒轮询。
# 默认：3
CONFIG_CACHE_TTL_SECS=3


# =============================================================================
# 4. 认证与安全
# =============================================================================

# 必填。JWT HMAC 签名密钥，建议至少 32 字节随机值。
# 生成：openssl rand -hex 32
# 留空会使用代码内置开发密钥；REQUIRE_SECURE_SECRETS=true 时拒绝启动。
JWT_SECRET=

# Token 有效期读取优先级：
#   JWT_EXPIRE_HOURS（小时） > JWT_EXPIRES_SECS（秒） > 默认 24h
# 示例：
# JWT_EXPIRE_HOURS=24
# JWT_EXPIRES_SECS=86400

# true：JWT_SECRET 为默认值或长度 <16 时拒绝启动。
# 生产强烈建议 true；代码默认 false。
REQUIRE_SECURE_SECRETS=true

# 是否开放 POST /api/v1/auth/register 自助注册。
# 默认：false
ALLOW_REGISTER=false

# 登录/注册是否要求图片验证码。
# 默认：true；集成测试通常显式设为 false。
CAPTCHA_ENABLED=true

# 首次启动写入演示账号 demo@lagran.dev / demo123，并创建演示域名。
# 仅用于体验；生产必须设为 false。
# 默认：true
SEED_DEMO=true

# 控制面全局 Agent 令牌；兼容旧名 EDGE_AGENT_TOKEN。
# 用于全局 DNS 调度接口；边缘节点自身的配置/心跳/证书使用节点独立 token。
# 留空时启动会告警，部分全局能力受限。
AGENT_TOKEN=
# EDGE_AGENT_TOKEN=


# =============================================================================
# 5. GeoDNS / 节点调度
# =============================================================================

# GeoIP 数据路径。读取顺序：
#   GEOIP_PATH → GEOIP_DAT_PATH → GEOIP_JSON_PATH
# 支持 V2Ray/Loyalsoldier geoip.dat（protobuf）和旧版 JSON CIDR 表。
# 默认：./data/geoip.dat
GEOIP_PATH=./data/geoip.dat
# 兼容别名（仅当前面的变量为空时生效）：
# GEOIP_DAT_PATH=./data/geoip.dat
# GEOIP_JSON_PATH=./data/geoip.json

# 调度 API 返回的 DNS TTL（秒），代码钳制 5–3600。
# 默认：30
SCHEDULE_TTL=30

# 控制台“DNS 测试”使用的上游 DNS（host:port）。
# 默认：127.0.0.1:53
DNS_TEST_SERVER=127.0.0.1:53


# =============================================================================
# 6. ACME / Let's Encrypt
# =============================================================================

# ACME Directory URL；调试时使用 staging，避免生产 rate limit。
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
ACME_STAGING_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory

# ACME 账户联系邮箱（可选）。
ACME_CONTACT_EMAIL=


# =============================================================================
# 7. 数据保留与告警
# =============================================================================

# access_logs / edge_metrics 保留天数；0 表示不自动清理。
# 后台约每小时清理一次。
# 默认：30
LOG_RETENTION_DAYS=30

# 告警规则评估间隔（秒），代码钳制 5–3600。
# 默认：30
ALERT_EVAL_SECS=30


# =============================================================================
# 8. 可观测性
# =============================================================================

# OTLP/HTTP Trace 导出地址；留空关闭。
# 兼容别名 OTEL_ENDPOINT。
# 示例：http://127.0.0.1:4318
# 代码会自动追加 /v1/traces。
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_ENDPOINT=

# OpenTelemetry service.name。
# 默认：lagran-control
OTEL_SERVICE_NAME=lagran-control

# Trace 采样率，0.0–1.0。
# 默认：1.0
OTEL_TRACES_SAMPLER_ARG=1.0

# 统一边缘接入域名，用于节点安装命令/展示。
# 读取优先级：EDGE_CNAME → EDGE_ACCESS_DOMAIN。
# 留空时不展示统一 CNAME。
EDGE_CNAME=
# EDGE_ACCESS_DOMAIN=

# Telegram 通知 API 根地址（通常不需要修改）。
# 适用于企业代理或自建 Bot API；留空使用 https://api.telegram.org。
# 告警渠道自身的 api_base 优先级更高。
# TELEGRAM_API_BASE=
# Telegram 通知代理。代码显式读取 HTTPS_PROXY / https_proxy / ALL_PROXY /
# all_proxy，且告警渠道配置中的 proxy 优先。
# HTTPS_PROXY=
# ALL_PROXY=


# =============================================================================
# 9. 日志
# =============================================================================

# tracing 过滤。dotenvy 在读取 RUST_LOG 前加载，因此可写在 .env。
# 示例：RUST_LOG=control=info,tower_http=info,sqlx=warn
# 全量：RUST_LOG=debug
RUST_LOG=control=info,tower_http=info,sqlx=warn

# 程序崩溃时输出 backtrace（可选）。
# RUST_BACKTRACE=1


# =============================================================================
# 10. 系统升级
# =============================================================================

# GitHub 仓库（owner/repo），用于系统设置页检测新版本。
# 默认：Lagran93/Lagran
LAGRAN_UPDATE_REPO=Lagran93/Lagran

# root 更新助手路径；install.sh control 会安装到该位置。
# 默认：/opt/lagran/bin/lagran-update
# LAGRAN_UPDATE_HELPER=/opt/lagran/bin/lagran-update

# 更新请求/状态文件；必须与 lagran-update.path 单元一致。
# 默认：/var/lib/lagran/update.request、/var/lib/lagran/update.status
# LAGRAN_UPDATE_REQUEST_PATH=/var/lib/lagran/update.request
# LAGRAN_UPDATE_STATUS_PATH=/var/lib/lagran/update.status


# =============================================================================
# 11. 构建期变量（不需要写入运行时 EnvironmentFile）
# =============================================================================

# build.rs 优先读取 LAGRAN_GIT_HASH，其次 GITHUB_SHA，最后 git rev-parse。
# 注入到 /health、/ready、Prometheus 和节点版本中，格式：0.1.0+abc1234。
# LAGRAN_GIT_HASH=abc1234


# =============================================================================
# 运维提示
# =============================================================================
# - 健康检查：GET /health    就绪：GET /ready    指标：GET /metrics
# - 管理 API 前缀：/api/v1/*
# - 当前 CORS 允许任意 Origin；生产建议同域反向代理
# - 修改域名/规则后会尝试 POST 在线边缘 /__lagran/config/reload
# - 启动时自动执行数据库迁移（sqlx::migrate!）
# - 建议用 systemd 管理进程并限制 EnvironmentFile 权限
