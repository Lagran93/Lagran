################################################################################
# Lagran CDN 控制面（Control Plane）环境变量
# 应用：apps/control  → 二进制 lagran-control
#
# 快速开始：
#   cp control.env.example control.env
#   chmod 600 control.env
#   set -a && source control.env && set +a
#   ./lagran-control
#
# systemd 使用 EnvironmentFile=/etc/lagran/control.env。
#
# 阅读约定：
#   [必填]       未设置或为空会导致功能不可用/拒绝启动；
#   [生产建议]   生产环境应显式配置或修改；
#   [可选]       留空即关闭或使用默认值；
#   [默认]       未设置时使用的代码默认值。
#
# 注意：本文件包含 JWT/数据库/Agent/WAF 等密钥，生产环境权限建议 0600，
# 不要提交真实 control.env，也不要放进公开镜像。
################################################################################


# =============================================================================
# 1. 监听与对外地址
# =============================================================================

# 控制面 HTTP 监听地址。优先于 CONTROL_HOST + CONTROL_PORT。
# 默认：0.0.0.0:8080
CONTROL_BIND=0.0.0.0:8080

# 旧式拆分配置，仅在 CONTROL_BIND 为空时生效；新部署只用 CONTROL_BIND。
# CONTROL_HOST=0.0.0.0
# CONTROL_PORT=8080

# `lagran-control health` 子命令使用的健康检查 URL。
# 留空时按 CONTROL_BIND 的端口推导为 http://127.0.0.1:<port>/health。
# CONTROL_HEALTH_URL=

# 控制面公网根地址（不带末尾 /），用于生成节点安装命令中的 CONTROL_URL。
# 不用于 Edge → Control 的回调；节点回调地址是节点自己的 AGENT_URL。
# 留空时按请求 Host 推断；生产建议填写 HTTPS 地址。
# 示例：https://control.example.com
CONTROL_PUBLIC_URL=

# 可信反向代理列表（IP 或 CIDR，逗号分隔）。
# 只有来自这些地址的 X-Forwarded-For / X-Real-IP 才会被登录限流和登录日志采信；
# 其他直连请求使用 TCP 对端地址，客户端伪造转发头不会获得新的限流桶。
# 默认：127.0.0.1,::1（适配本机 Caddy 反代）。
# Caddy 在 Docker、另一台主机或前面还有 Cloudflare 时，需要把对应回源网段加入这里。
TRUSTED_PROXIES=127.0.0.1,::1


# =============================================================================
# 2. PostgreSQL
# =============================================================================

# [必填] sqlx PostgreSQL 连接串。
# 生产建议独立账号、强密码；远程数据库使用 ?sslmode=require。
# 默认：postgres://lagran:lagran@127.0.0.1:5432/lagran
DATABASE_URL=postgres://lagran:lagran@127.0.0.1:5432/lagran

# 每个 control 进程的连接池上限，代码钳制 2–200。
# 多副本总连接数 = 副本数 × 本值，不能超过 PostgreSQL max_connections。
# 默认：32（每进程）。多副本总连接数 = 副本数 × 本值 + 预留，
# 不得超过 PostgreSQL max_connections（默认 100）。
DATABASE_MAX_CONNECTIONS=32

# 每个进程保持的空闲连接数，不能大于 DATABASE_MAX_CONNECTIONS。
# 默认：2
DATABASE_MIN_CONNECTIONS=2

# 获取连接超时（秒），代码钳制 1–60。
# 默认：5
DATABASE_ACQUIRE_TIMEOUT_SECS=5

# 启动时会自动执行 sqlx migrations；生产升级前请先备份数据库。


# =============================================================================
# 3. Redis（可选，共享状态）
# =============================================================================

# [可选] 留空时以下能力回退到进程内状态或 PostgreSQL：
#   登录限流、验证码、会话缓存、配置缓存、分布式锁、实时统计。
# 支持 redis://、rediss://（TLS）、带 ACL 密码的 URL。
# 示例：redis://:password@127.0.0.1:6379/0
# 生产建议内网访问、密码/ACL；跨主机启用 TLS。
# 设置后控制面会话缓存生效：每个请求的 Actor 鉴权从 1 次 PostgreSQL
# 往返降为 1 次 Redis GET；Redis 不可用时自动回退到数据库。
REDIS_URL=

# Redis 会话缓存 TTL（秒），代码钳制 5–300。
# 用户角色、密码、启用状态变更时会主动失效。
# 默认：30
REDIS_SESSION_TTL_SECS=30

# 边缘批量配置的进程内缓存 TTL（秒），代码钳制 1–60。
# 配置变更最多延迟该 TTL 生效；Edge 默认 15 秒轮询。
# 默认：3
CONFIG_CACHE_TTL_SECS=3


# =============================================================================
# 4. 认证、会话与注册
# =============================================================================

# [必填] JWT HMAC 签名密钥，建议至少 32 字节随机值。
# 生成：openssl rand -hex 32
# 留空会使用代码内置开发密钥；REQUIRE_SECURE_SECRETS=true 时拒绝启动。
JWT_SECRET=

# Token 有效期读取优先级：
#   JWT_EXPIRE_HOURS（小时） > JWT_EXPIRES_SECS（秒） > 默认 24h
# JWT_EXPIRE_HOURS=24
# JWT_EXPIRES_SECS=86400

# [生产建议] true：JWT_SECRET 为默认值或长度 <16 时拒绝启动。
# 代码默认：false；生产强烈建议 true。
REQUIRE_SECURE_SECRETS=true

# 是否开放 POST /api/v1/auth/register 自助注册。
# 默认：false
#
# 首次部署取账户的方式：
#   1) 临时改为 true，重启控制面；
#   2) 在控制台注册第一个账号；
#   3) 数据库没有账户时，第一个注册账号自动获得 admin；
#   4) 拿到管理员后改回 false 并重启。
#
# 该判定与 INSERT 在同一条 SQL 内完成，多个并发注册也只有一个会成为管理员。
# 首个账号获得 admin 时日志会打印：
#   WARN ... first account registered and granted admin; disable ALLOW_REGISTER now
#
# 注意：SEED_DEMO=true 且 REQUIRE_SECURE_SECRETS=true 时会拒绝启动，
# 因此生产环境不能靠 demo 账号起步。
ALLOW_REGISTER=false

# 登录/注册是否要求图片验证码。
# 默认：true；集成测试通常显式设为 false。
CAPTCHA_ENABLED=true

# 允许跨域调用 API 的浏览器来源（逗号分隔，需带 scheme）。
#
# 留空（默认）：保持宽松策略，回显任意 Origin，适用于控制台与 API 同源部署。
# 配置后：只允许列出的来源，其余跨域请求被拒绝；非法条目会被丢弃。
# 如果所有条目都非法，则拒绝所有跨域（fail-closed）。
#
# 控制台使用 Bearer token（localStorage），浏览器不会自动携带 Cookie，
# 因此不存在经典 CSRF；此项属于收敛攻击面。
# CORS_ALLOWED_ORIGINS=https://console.example.com,https://admin.example.com

# 仅用于本地体验：首次启动写入 demo@lagran.dev / demo123，并创建
# cdn.example.com 演示域名。不会自动授予管理员。
# 与 REQUIRE_SECURE_SECRETS=true 同时开启会拒绝启动。
# 默认：false
SEED_DEMO=false


# =============================================================================
# 5. 节点令牌与签名
# =============================================================================

# [生产建议] 控制面全局 Agent 令牌；兼容旧名 EDGE_AGENT_TOKEN。
# 用于全局 DNS 调度接口；边缘节点自身的配置/心跳/证书使用节点独立 token。
# 留空时启动会告警，部分全局能力受限。
AGENT_TOKEN=
# EDGE_AGENT_TOKEN=

# 边缘管理面使用自签/内部 CA 的 HTTPS 时，额外信任的 CA PEM。
# 控制面回调 https://AGENT_URL 时使用；WebPKI 根证书始终可用。
# AGENT_TLS_CA_FILE=/etc/lagran/edge-admin-ca.pem

# 允许 AGENT_TOKEN 为空时仍开放 /api/v1/schedule（无需鉴权）。
# 仅供本地开发；开启后任何能访问控制面端口的人都能拿到全部边缘节点 IP。
# 默认：false（AGENT_TOKEN 为空时调度接口直接拒绝）
# ALLOW_UNAUTHENTICATED_SCHEDULE=false

# [生产必填] WAF 规则包签名密钥；Control 与所有 Edge 必须完全一致。
# 留空时：
#   - Edge 拒绝所有签名规则包；
#   - 托管规则集退回配置文档里的 managed 开关；
#   - 发布接口返回 503；
#   - REQUIRE_SECURE_SECRETS=true 时 Control 直接拒绝启动。
#
# 轮换密钥：先改 Control 与所有 Edge，再重启 Control。启动时会用新密钥自校验
# 当前 active 规则包，验签失败则原地重新签名（payload 不变），无需手工发布。
# 注意：值会被原样使用，WAF_RULEPACK_SECRET="abc" 与 =abc 不同。
# WAF_RULEPACK_SECRET=


# =============================================================================
# 6. GeoDNS 与节点调度
# =============================================================================

# 地理位置库路径。读取优先级：
#   GEOIP_PATH → GEOIP_IP2REGION_PATH → GEOIP_DAT_PATH → GEOIP_JSON_PATH
# 推荐 ip2region XDB；兼容 V2Ray/Loyalsoldier geoip.dat 与旧版 JSON。
# 默认：./data/ip2region_v4.xdb
GEOIP_PATH=./data/ip2region_v4.xdb

# [可选] IPv6 客户端使用独立 ip2region v6 库。
# GEOIP_IPV6_PATH=./data/ip2region_v6.xdb

# 兼容别名（仅当前面的变量为空时生效）：
# GEOIP_IP2REGION_PATH=./data/ip2region_v4.xdb
# GEOIP_DAT_PATH=./data/geoip.dat
# GEOIP_JSON_PATH=./data/geoip.json

# 调度 API 返回的 DNS TTL（秒），代码钳制 5–3600。
# 默认：30
SCHEDULE_TTL=30

# 调度器缓存 edge_nodes 表的秒数，避免每次 DNS 未命中都查库。
# 0 表示不缓存；代码钳制 0–300。默认：5
SCHEDULE_NODE_CACHE_SECS=5

# 控制台“DNS 测试”使用的上游 DNS（host:port）。
# 默认：127.0.0.1:53
DNS_TEST_SERVER=127.0.0.1:53

# 统一边缘接入域名，用于节点安装命令/展示。
# 读取优先级：EDGE_CNAME → EDGE_ACCESS_DOMAIN。
# 留空时不展示统一 CNAME。
EDGE_CNAME=
# EDGE_ACCESS_DOMAIN=


# =============================================================================
# 7. ACME / Let's Encrypt
# =============================================================================

# ACME Directory URL；调试时使用 staging，避免生产 rate limit。
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
ACME_STAGING_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory

# ACME 账户联系邮箱（可选）。
ACME_CONTACT_EMAIL=


# =============================================================================
# 8. 数据保留、告警与通知
# =============================================================================

# access_logs / edge_metrics / waf_events / login_logs 保留天数；0 表示不自动清理。
# 后台约每小时清理一次。
# 默认：30
LOG_RETENTION_DAYS=30

# 告警规则评估间隔（秒），代码钳制 5–3600。
# 默认：30
ALERT_EVAL_SECS=30

# Telegram 通知 API 根地址（通常不需要修改）。
# 适用于企业代理或自建 Bot API；留空使用 https://api.telegram.org。
# 告警渠道自身配置的 api_base 优先级更高。
# TELEGRAM_API_BASE=

# Telegram 通知代理。代码显式读取 HTTPS_PROXY / https_proxy /
# ALL_PROXY / all_proxy；告警渠道配置中的 proxy 优先。
# HTTPS_PROXY=
# ALL_PROXY=


# =============================================================================
# 9. 可观测性
# =============================================================================

# OTLP/HTTP Trace 导出地址；留空关闭。
# 兼容别名 OTEL_ENDPOINT。
# 示例：http://127.0.0.1:4318
# 代码会自动追加 /v1/traces。
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_ENDPOINT=

# OpenTelemetry service.name。
# 默认：lagran-control
OTEL_SERVICE_NAME=lagran-control

# Trace 采样率，0.0–1.0。
# 默认：1.0
OTEL_TRACES_SAMPLER_ARG=1.0


# =============================================================================
# 10. 内容预热
# =============================================================================

# 缓存预热回调超时（秒），默认 300，范围 30–1800。
# 大对象超过 Edge RANGE_FILL_MAX_BYTES 时会自动改为 Range 前缀预热。
# PREFETCH_TIMEOUT_SECS=300


# =============================================================================
# 11. 日志
# =============================================================================

# tracing 过滤。dotenvy 在读取 RUST_LOG 前加载，因此可写在 .env。
# 示例：RUST_LOG=control=info,tower_http=info,sqlx=warn
# 全量：RUST_LOG=debug
RUST_LOG=control=info,tower_http=info,sqlx=warn

# 程序崩溃时输出 backtrace（可选）。
# RUST_BACKTRACE=1


# =============================================================================
# 12. 系统升级
# =============================================================================

# GitHub 仓库（owner/repo），用于系统设置页检测新版本。
# 默认：Lagran93/Lagran
LAGRAN_UPDATE_REPO=Lagran93/Lagran

# root 更新助手路径；install.sh control 会安装到该位置。
# 默认：/opt/lagran/bin/lagran-update
# LAGRAN_UPDATE_HELPER=/opt/lagran/bin/lagran-update

# 更新请求/状态文件；必须与 lagran-update.path 单元一致。
# 默认：/var/lib/lagran/update.request、/var/lib/lagran/update.status
# LAGRAN_UPDATE_REQUEST_PATH=/var/lib/lagran/update.request
# LAGRAN_UPDATE_STATUS_PATH=/var/lib/lagran/update.status


# =============================================================================
# 13. 构建期变量（不需要写入运行时 EnvironmentFile）
# =============================================================================

# build.rs 优先读取 LAGRAN_GIT_HASH，其次 GITHUB_SHA，最后 git rev-parse。
# 注入到 /health、/ready、Prometheus 和节点版本中，格式：0.1.0+abc1234。
# LAGRAN_GIT_HASH=abc1234
# 构建系统也可以直接注入完整版本号；不设置时使用 Cargo 包版本。
# LAGRAN_BUILD_VERSION=0.1.0


# =============================================================================
# 运维提示
# =============================================================================
# - 健康检查：GET /health    就绪：GET /ready    指标：GET /metrics
# - 管理 API 前缀：/api/v1/*
# - CORS 默认回显任意 Origin；生产建议配置 CORS_ALLOWED_ORIGINS 或同域反代
# - 修改域名/规则后会尝试 POST 在线边缘 /__lagran/config/reload
# - 启动时自动执行数据库迁移（sqlx::migrate!）
# - systemd 建议：EnvironmentFile=/etc/lagran/control.env，权限 0600
# - 所有 control 副本的 JWT_SECRET、AGENT_TOKEN、WAF_RULEPACK_SECRET 必须一致
