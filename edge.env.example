################################################################################
# Lagran CDN 边缘节点（Edge Plane）环境变量
# 应用：apps/edge  → 二进制 lagran-edge
#
# 使用方式：
#   cp edge.env.example edge.env
#   set -a && source edge.env && set +a
#   ./lagran-edge
# systemd 使用 EnvironmentFile=/etc/lagran/edge.env。
#
# 节点令牌必须来自控制台预注册节点（auth_token），不是控制面的全局
# AGENT_TOKEN；缺失时心跳/配置/证书接口会返回 401。
################################################################################

# =============================================================================
# 1. 监听地址
# =============================================================================

# 面向访客的 HTTP 监听地址（Pingora 公共入口）。
# 默认：0.0.0.0:8081
EDGE_LISTEN=0.0.0.0:8081

# HTTPS 监听地址（可选）。留空表示不启用 HTTPS。
# 证书从 CERT_DIR 加载，支持 SNI 与热更新。
# 示例：EDGE_HTTPS_LISTEN=0.0.0.0:443
# EDGE_HTTPS_LISTEN=

# 管理与 Agent 接口监听地址（推荐单独端口，必须与 EDGE_LISTEN 不同）。
# 承载 purge、config/reload、证书热载、metrics、access-logs、challenge 等。
# 留空时挂载在 EDGE_LISTEN 上，仅建议本地开发。
EDGE_ADMIN_LISTEN=127.0.0.1:8082

# HTTP→HTTPS 跳转端口。留空时从 EDGE_HTTPS_LISTEN 推导；
# HTTPS 端口为 443 时省略端口。
# EDGE_HTTPS_REDIRECT_PORT=443


# =============================================================================
# 2. 节点身份与控制面连接
# =============================================================================

# 节点 ID，必须与控制台预注册节点一致；心跳、日志、metrics 都使用它。
# 默认：edge-001
NODE_ID=edge-001

# 区域标签（展示和调度参考，不参与 IP 归属判断）。
# 默认：local
NODE_REGION=local

# 节点公网 IP。GeoDNS 调度需要；留空时可能无法被地理调度选中。
PUBLIC_IP=

# 控制面根 URL（不带末尾 /）。
# 默认：http://127.0.0.1:8080
CONTROL_URL=http://127.0.0.1:8080

# 控制面回调本节点的 Agent URL，用于 purge/reload/证书下发。
# 默认按 EDGE_ADMIN_LISTEN 或 EDGE_LISTEN 推导为
# http://127.0.0.1:<port>；多机部署必须填写控制面可达地址。
AGENT_URL=http://127.0.0.1:8082

# 节点鉴权令牌，请求头 X-Lagran-Agent-Token。
# 控制台创建节点时只展示一次；兼容旧名 EDGE_AGENT_TOKEN。
AGENT_TOKEN=
# EDGE_AGENT_TOKEN=

# 本地调试：允许空 AGENT_TOKEN 访问管理接口。
# 生产必须 false；默认 false。
ALLOW_INSECURE_AGENT=false

# 心跳间隔（秒）。控制面约 60 秒未收到心跳会标记节点离线。
# 默认：15
HEARTBEAT_INTERVAL=15

# 从控制面拉取配置的间隔（秒），代码钳制 5–300。
# 控制面变更还会主动 POST /__lagran/config/reload。
# 默认：15
CONFIG_SYNC_INTERVAL_SECS=15

# 兼容旧版单域名模式：仅当控制面域名注册表为空时，按该域名拉取配置。
# 默认：空
# EDGE_DOMAIN=


# =============================================================================
# 3. 源站与缓存（全局默认；具体域名以控制面下发为准）
# =============================================================================

# 未匹配已接入域名时的默认回源地址。
# 默认：https://example.com
ORIGIN_URL=https://example.com

# 规则未命中时的默认缓存 TTL（秒）。
# 默认：60
CACHE_TTL=60

# 内存缓存最大条目数。
# 默认：10000
CACHE_CAPACITY=10000

# 缓存后端：memory | disk | hybrid。
# 默认：memory
CACHE_BACKEND=memory

# 磁盘缓存目录（disk / hybrid）。
# 默认：./data/cache
DISK_CACHE_DIR=./data/cache

# 磁盘缓存最大字节数。
# 默认：1073741824（1 GiB）
DISK_CACHE_MAX_BYTES=1073741824

# 可写入缓存的单个响应体上限（字节），钳制 64 KiB–64 MiB。
# 超限响应仍会回源，但不会写入缓存。
# 默认：8388608（8 MiB）
MAX_CACHEABLE_BODY=8388608

# 大对象流式磁盘缓存（Phase 2）。
# 开启后，带 Content-Length 的 200 大对象会流式写入 LARGE_CACHE_DIR，
# 不会在内存中累积完整响应；命中时从磁盘分块读回。
# 默认：false
LARGE_CACHE_ENABLED=false

# 大对象缓存目录，建议独立 SSD 挂载点。
# 默认：./data/large-cache
LARGE_CACHE_DIR=./data/large-cache

# 进入大对象缓存的最小/最大对象字节数。
# 小于 LARGE_CACHE_MIN_OBJECT_BYTES 的对象继续走普通内存/磁盘缓存。
# 超过 LARGE_CACHE_MAX_OBJECT_BYTES 的对象直接回源，不缓存。
# 默认：8388608（8 MiB） / 1073741824（1 GiB）
LARGE_CACHE_MIN_OBJECT_BYTES=8388608
LARGE_CACHE_MAX_OBJECT_BYTES=1073741824

# 大对象缓存总容量（字节），超过后按最旧文件淘汰。
# 默认：21474836480（20 GiB）
LARGE_CACHE_MAX_BYTES=21474836480

# 证书目录：<domain>.crt + <domain>.key；启动加载、热更新回写。
# 默认：./data/certs
CERT_DIR=./data/certs


# =============================================================================
# 4. WAF 质询
# =============================================================================

# 浏览器质询 nonce / clearance Cookie 的 HMAC 密钥。
# 留空时由 AGENT_TOKEN 派生；AGENT_TOKEN 也为空则进程随机（重启失效）。
# 多节点部署必须设置相同值，否则质询无法跨节点通过。
# CHALLENGE_SECRET=


# =============================================================================
# 5. 限流、CC 与 WAF 上报
# =============================================================================

# 全局默认限流 RPS/突发；域名配置为 0 时使用。
# 默认：0（不限流）
# RATE_LIMIT_RPS=0
# RATE_LIMIT_BURST=0

# 跨节点共享 CC 封禁拉取间隔（秒），代码最小 2。
# 默认：5
CC_SYNC_INTERVAL=5

# 可选 Redis，用于多 Edge 共享 CC 滑动窗口计数。
# 留空时使用进程内固定窗口（单节点模式）。
# 生产多节点建议与控制面共用同一个 Redis，例如：
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# CC Redis key 前缀，避免与其他业务 key 冲突。
# 默认：lagran:cc
CC_REDIS_PREFIX=lagran:cc

# CC 路径独立预算倍率：
# 静态资源 = 基础限额 × CC_STATIC_MULTIPLIER
# 登录/认证 = 基础限额 ÷ CC_AUTH_DIVISOR（至少 1）
# 下载/媒体 = 基础限额 × CC_DOWNLOAD_MULTIPLIER
# API 与动态页面使用基础限额。
# 默认：8 / 2 / 2
CC_STATIC_MULTIPLIER=8
CC_AUTH_DIVISOR=2
CC_DOWNLOAD_MULTIPLIER=2

# 轻量浏览器行为评分（可选）：仅对 HTML 动态/登录页面生效。
# 根据 UA、Accept-Language、Sec-CH-UA、Sec-Fetch-Mode、Cookie 等信号评分，
# 达到阈值时先返回 PoW 挑战，而不是直接封禁。
# 默认关闭，避免影响命令行/API 客户端。
CC_BEHAVIOR_ENABLED=false
CC_BEHAVIOR_SCORE=4

# 是否上报 WAF 事件到控制面。
# 默认：true
WAF_REPORT=true

# WAF 事件上报间隔（秒）。
# 默认：5
WAF_REPORT_INTERVAL=5


# =============================================================================
# 6. 源站健康检查（主备切换防抖）
# =============================================================================

# 连续失败多少次后标记不健康，钳制 1–20。
# 默认：3
ORIGIN_HEALTH_FAIL_THRESHOLD=3

# 连续成功多少次后恢复健康，钳制 1–20。
# 默认：2
ORIGIN_HEALTH_RECOVER_THRESHOLD=2

# 探测间隔（秒），钳制 5–300。
# 默认：30
ORIGIN_HEALTH_INTERVAL_SECS=30


# =============================================================================
# 7. 访问日志
# =============================================================================

# 访问日志文件路径；留空只输出到 tracing。
# ACCESS_LOG_PATH=./data/access.log

# true = JSON Lines；false = 文本 combined 风格。
# 默认：false
ACCESS_LOG_JSON=false

# 内存环形缓冲条数，代码钳制 100–50000。
# 默认：2000
ACCESS_LOG_BUFFER=2000

# 是否批量上报访问日志到 POST /api/v1/access-logs/report。
# 默认：true
ACCESS_LOG_REPORT=true

# 批量上报间隔（秒）。
# 默认：30
ACCESS_LOG_REPORT_INTERVAL=30


# =============================================================================
# 8. 反向代理与信任头
# =============================================================================

# 是否信任前置代理写入的 X-Forwarded-For / X-Forwarded-Proto。
# false：Pingora 使用真实对端 IP 并覆盖客户端伪造的 XFF。
# true：保留 SLB / Cloudflare 等可信代理写入的头。
# 只有边缘前面确实存在可信代理时才开启。
# 默认：false
TRUST_PROXY_HEADERS=false


# =============================================================================
# 9. 日志
# =============================================================================

# 示例：RUST_LOG=edge=info,tower_http=info
# 全量：RUST_LOG=debug
RUST_LOG=edge=info,tower_http=info

# 程序崩溃时输出 backtrace（可选）。
# RUST_BACKTRACE=1


# =============================================================================
# 10. 构建期变量（不需要写入运行时 EnvironmentFile）
# =============================================================================

# build.rs 优先使用 LAGRAN_GIT_HASH，其次 GITHUB_SHA，最后 git rev-parse。
# 节点心跳会上报 0.1.0+<短 hash>，控制台节点列表可见。
# LAGRAN_GIT_HASH=abc1234


# =============================================================================
# 运维提示
# =============================================================================
# - 业务健康：GET /__lagran/health
# - 配置热拉：POST /__lagran/config/reload（需 Agent 令牌）
# - 刷新缓存：POST /__lagran/purge
# - Prometheus：GET /__lagran/metrics（建议只走管理口）
# - 证书热载：POST /__lagran/certs/load
# - 管理认证头：X-Lagran-Agent-Token
# - EDGE_ADMIN_LISTEN 绝不能暴露到公网
