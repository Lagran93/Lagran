################################################################################
# Lagran CDN 边缘节点（Edge Plane）环境变量
# 应用：apps/edge  → 二进制 lagran-edge
#
# 使用方式：
#   cp edge.env.example edge.env
#   set -a && source edge.env && set +a
#   ./lagran-edge
# systemd 使用 EnvironmentFile=/etc/lagran/edge.env。
#
# 节点令牌必须来自控制台预注册节点（auth_token），不是控制面的全局
# AGENT_TOKEN；缺失时心跳/配置/证书接口会返回 401。
################################################################################

# =============================================================================
# 1. 监听地址
# =============================================================================

# 面向访客的 HTTP 监听地址（Pingora 公共入口）。
# 默认：0.0.0.0:8081
EDGE_LISTEN=0.0.0.0:8081

# Pingora 数据面工作线程数。默认等于可用 CPU 核数。
# Pingora 自身默认只有 1 个线程：单线程会把下行 TLS、WAF 扫描和回源 TLS
# 握手全部串行到同一个核上，回源请求互相排队，表现为“回源很慢”。
# 仅在需要手动覆盖时取消注释，钳制范围 1–256。
# EDGE_WORKER_THREADS=4

# HTTPS 监听地址（可选）。留空表示不启用 HTTPS。
# 证书从 CERT_DIR 加载，支持 SNI 与热更新。
# 示例：EDGE_HTTPS_LISTEN=0.0.0.0:443
# EDGE_HTTPS_LISTEN=

# 管理与 Agent 接口监听地址（推荐单独端口，必须与 EDGE_LISTEN 不同）。
# 承载 purge、config/reload、证书热载、metrics、access-logs、challenge 等。
# 留空时挂载在 EDGE_LISTEN 上，仅建议本地开发。
EDGE_ADMIN_LISTEN=127.0.0.1:8082

# HTTP→HTTPS 跳转端口。留空时从 EDGE_HTTPS_LISTEN 推导；
# HTTPS 端口为 443 时省略端口。
# EDGE_HTTPS_REDIRECT_PORT=443


# =============================================================================
# 2. 节点身份与控制面连接
# =============================================================================

# 节点 ID，必须与控制台预注册节点一致；心跳、日志、metrics 都使用它。
# 默认：edge-001
NODE_ID=edge-001

# 区域标签（展示和调度参考，不参与 IP 归属判断）。
# 默认：local
NODE_REGION=local

# 节点公网 IP。GeoDNS 调度需要；留空时可能无法被地理调度选中。
PUBLIC_IP=

# 控制面根 URL（不带末尾 /）。
# 默认：http://127.0.0.1:8080
CONTROL_URL=http://127.0.0.1:8080

# 控制面回调本节点的 Agent URL，用于 purge/reload/证书下发。
# 默认按 EDGE_ADMIN_LISTEN 或 EDGE_LISTEN 推导为
# http://127.0.0.1:<port>；多机部署必须填写控制面可达地址。
AGENT_URL=http://127.0.0.1:8082

# 节点鉴权令牌，请求头 X-Lagran-Agent-Token。
# 控制台创建节点时只展示一次；兼容旧名 EDGE_AGENT_TOKEN。
AGENT_TOKEN=
# EDGE_AGENT_TOKEN=

# 与控制面相同的 WAF 规则包签名密钥；不一致时规则包验签失败，日志会持续
# 出现 "WAF rulepack HMAC verification failed"（Control 重启时会用新密钥重新
# 签名 active 规则包，但 Edge 侧这一份必须与 Control 完全一致）。
# 留空时所有签名规则包都会被拒绝（不存在内置默认密钥），托管规则集退回
# 配置文档里的 managed 开关。生产必须设置，且与 Control 完全一致。
# 注意值会被原样使用，加引号与不加引号是不同的值。
# WAF_RULEPACK_SECRET=

# 验签通过的 WAF 规则包缓存目录。默认 ./data/waf-rulepacks
# WAF_RULEPACK_CACHE_DIR=./data/waf-rulepacks

# WAF Geo/ASN 黑白名单使用的 MaxMind GeoLite2 数据库（本地文件路径）。
# 缺失或损坏时：黑名单不生效，白名单会拦截全部流量，其余 WAF 功能不受影响。
# 默认值即下方路径，需把 mmdb 文件放到数据目录。
# GEOIP_COUNTRY_DB=./data/maxmind/GeoLite2-Country.mmdb
# GEOIP_ASN_DB=./data/maxmind/GeoLite2-ASN.mmdb

# 本地调试：允许空 AGENT_TOKEN 访问管理接口。
# 生产必须 false；默认 false。
ALLOW_INSECURE_AGENT=false

# 心跳间隔（秒）。控制面约 60 秒未收到心跳会标记节点离线。
# 默认：15
HEARTBEAT_INTERVAL=15

# 从控制面拉取配置的间隔（秒），代码钳制 5–300。
# 控制面变更还会主动 POST /__lagran/config/reload。
# 默认：15
CONFIG_SYNC_INTERVAL_SECS=15

# 兼容旧版单域名模式：仅当控制面域名注册表为空时，按该域名拉取配置。
# 默认：空
# EDGE_DOMAIN=


# =============================================================================
# 3. 源站与缓存（全局默认；具体域名以控制面下发为准）
# =============================================================================

# 未匹配已接入域名时的默认回源地址。
# 默认：https://example.com
ORIGIN_URL=https://example.com

# 规则未命中时的默认缓存 TTL（秒）。
# 默认：60
CACHE_TTL=60

# 内存缓存最大条目数。
# 默认：10000
CACHE_CAPACITY=10000

# 缓存后端：memory | disk | hybrid。
# 默认：memory
CACHE_BACKEND=memory

# 磁盘缓存目录（disk / hybrid）。
# 默认：./data/cache
DISK_CACHE_DIR=./data/cache

# 磁盘缓存最大字节数。
# 默认：1073741824（1 GiB）
DISK_CACHE_MAX_BYTES=1073741824

# 可写入缓存的单个响应体上限（字节），钳制 64 KiB–64 MiB。
# 超限响应仍会回源，但不会写入缓存。
# 默认：8388608（8 MiB）
#
# 这个上限只约束内存/磁盘缓存。启用 LARGE_CACHE_ENABLED 后，超过
# LARGE_CACHE_MIN_OBJECT_BYTES 的对象走大对象缓存，不受本值限制
# ——详见下方 LARGE_CACHE_ENABLED 处的对照表。
MAX_CACHEABLE_BODY=8388608

# 从共享缓存 key 中排除的请求头，逗号分隔、不区分大小写。
# 适用场景：站点只有一个语言，Accept-Language 不影响响应体；或 CORS 允许
# 的 Origin 固定、响应体不随 Origin 变化。排除后预热请求与浏览器请求可共享
# 同一个 cache key；对应 GET/HEAD 的 Vary 字段也按忽略处理。
# 不适用：按语言返回不同内容，或 Access-Control-Allow-Origin 随 Origin 变化。
# 默认：空
# CACHE_KEY_IGNORE_HEADERS=accept-language,origin

# 内存缓存近似字节上限（LRU 淘汰），默认 512 MiB。
CACHE_MAX_BYTES=536870912

# 可选：Redis L2 共享缓存。CACHE_BACKEND=redis|l2 时启用。
# CACHE_REDIS_URL 为空则复用 REDIS_URL。
# CACHE_REDIS_URL=redis://127.0.0.1:6379/
# CACHE_REDIS_PREFIX=lagran:cache
# CACHE_L2_MAX_BODY=8388608
# CACHE_L2_READ_TIMEOUT_MS=250
# CACHE_L2_WRITE_TIMEOUT_MS=3000

# 跨节点请求合并（flight 锁）单次 Redis 往返的超时（毫秒）。
# 涵盖抢锁的 SET NX、等锁时的 EXISTS 轮询、以及释放锁的 EVAL。
# 默认：250，钳制 50–5000。
#
# Redis 不在本机时建议调大。超时后不会报错中断，而是降级为「各节点各自回源」，
# 并打印 WARN：flight lock unavailable; proceeding without cross-node coalescing。
# 该 WARN 频繁出现说明本值偏小或 Redis 有抖动，此时同一冷门对象会被多个请求重复回源。
# CACHE_FLIGHT_TIMEOUT_MS=250

# 回源读取空闲超时（毫秒），独立于域名连接/响应头超时。
# 流媒体持续有数据时不会因总传输时长被中断。
# 默认：30000（30 秒），钳制 1000–600000。
ORIGIN_READ_TIMEOUT_MS=30000

# 回源 TCP 连接超时（毫秒）。
# 与读取超时、域名请求总超时分离：源站不可达时应快速切换到下一个源站，
# 而不是每次回源都等满整个请求预算。
# 默认：3000（3 秒），钳制 500–60000。
ORIGIN_CONNECT_TIMEOUT_MS=3000

# 下行 gzip 压缩。回源统一取 identity 存入缓存，压缩在下发阶段按客户端
# Accept-Encoding 实时进行，因此一份缓存对象可服务所有客户端。
# 默认开启；设为 off/0/false/no 关闭。
EDGE_COMPRESSION=on
# 小于该字节数的响应不压缩（默认 1024，钳制 0–1048576）。
EDGE_COMPRESSION_MIN_BYTES=1024
# gzip 压缩级别，1（最快）–9（最小）。默认 4。
EDGE_COMPRESSION_LEVEL=4

# 预压缩副本缓存：同一对象只压缩一次，后续命中直接下发。
# 按 identity 缓存 key + ETag 键控，对象变化后旧副本自然失效。
# 关闭方式：把任一项设为 0。
# EDGE_COMPRESSED_CACHE_MAX_BYTES：内存上限，默认 67108864（64 MiB）。
# EDGE_COMPRESSED_CACHE_ENTRIES：条目上限，默认 10000。
# EDGE_COMPRESSED_CACHE_MAX_OBJECT：超过该字节数的对象不保留副本，默认 4194304（4 MiB）。
EDGE_COMPRESSED_CACHE_MAX_BYTES=67108864
EDGE_COMPRESSED_CACHE_ENTRIES=10000
EDGE_COMPRESSED_CACHE_MAX_OBJECT=4194304

# Range/视频流的回源读取空闲超时（毫秒）。
# 首次打开大视频时源站/存储可能超过 30 秒才返回第一个字节；Range 请求
# 使用该值，避免被普通回源超时误判为 504。
# 默认：120000（120 秒），钳制 5000–1800000。
ORIGIN_STREAM_READ_TIMEOUT_MS=120000

# 单次 Range 响应最多写入大缓存的字节数。
# 带结束位置的 Range 超过该值时不填充；开放式 `bytes=start-` 只缓存从 start
# 开始的前缀，后缀 Range 只缓存尾部，均不超过该值，避免首次播放写入数百 MB。
# 已完成的片段会记录在稀疏文件的 segment 元数据中，后续落在片段内的 Range 可命中。
# 0 表示禁用 Range 填充。默认：33554432（32 MiB），钳制 0–1 GiB。
RANGE_FILL_MAX_BYTES=33554432

# 下游 HTTP/1.1 keepalive 空闲超时（秒），钳制 5–3600。默认：60
DOWNSTREAM_KEEPALIVE_SECS=60
# 下游 HTTP/2 空闲超时（秒），钳制 5–3600。默认：120
DOWNSTREAM_H2_IDLE_SECS=120
# 单条下游连接最多处理的请求数，钳制 1–100000。默认：1000
DOWNSTREAM_KEEPALIVE_REQUESTS=1000

# 大对象流式磁盘缓存（Phase 2）。
# 开启后，带 Content-Length 的 200 大对象会流式写入 LARGE_CACHE_DIR，
# 不会在内存中累积完整响应；命中时从磁盘分块读回。
# 默认：false
#
# 与 MAX_CACHEABLE_BODY 的关系（两者互不影响，各管一段）：
#
#   响应大小                        | ENABLED=true        | =false（默认）
#   --------------------------------|---------------------|--------------------
#   < LARGE_CACHE_MIN_OBJECT_BYTES  | 内存/磁盘缓存        | 内存/磁盘缓存
#   >= MIN（且 <= MAX_OBJECT_BYTES）| LARGE_CACHE_DIR     | 内存/磁盘缓存
#                                   | 不看 MAX_CACHEABLE_BODY |
#   > MAX_CACHEABLE_BODY            | —（已由大缓存接住）  | 不缓存，每次回源
#
# 关键点：大对象走 LARGE_CACHE_DIR 时**不看** MAX_CACHEABLE_BODY。实测 16 MiB
# 对象在 MAX_CACHEABLE_BODY=8 MiB 下仍然进 L3 大缓存并命中；此时若把
# LARGE_CACHE_ENABLED 关掉，同样的 16 MiB 就会因为超过 MAX_CACHEABLE_BODY
# 而完全不缓存（每次回源）。
#
# 所以这两个开关是二选一的容量策略，不是叠加关系：
#   - 只用内存缓存：需要把 MAX_CACHEABLE_BODY 提到目标对象大小，否则大对象不缓存
#   - 启用大缓存：MAX_CACHEABLE_BODY 可保持默认，大对象自动落盘
#
# 响应头 x-lagran-cache-source 会标明实际来源（l1 内存 / l3 大缓存），
# 调整这些参数后用它确认对象落在哪一层。
LARGE_CACHE_ENABLED=false

# 大对象缓存目录，建议独立 SSD 挂载点。
# 默认：./data/large-cache
LARGE_CACHE_DIR=./data/large-cache

# 进入大对象缓存的最小/最大完整对象字节数。
# 小于 LARGE_CACHE_MIN_OBJECT_BYTES 的对象继续走普通内存/磁盘缓存。
# 完整对象超过 LARGE_CACHE_MAX_OBJECT_BYTES 时不缓存完整 GET；
# 但 Range 请求仍可缓存有界片段（不超过 RANGE_FILL_MAX_BYTES），
# 因为稀疏文件只占用实际写入的 segment。
# 默认：8388608（8 MiB） / 1073741824（1 GiB）
LARGE_CACHE_MIN_OBJECT_BYTES=8388608
LARGE_CACHE_MAX_OBJECT_BYTES=1073741824

# 大对象缓存总容量（字节），超过后按最旧文件淘汰。
# 默认：21474836480（20 GiB）
LARGE_CACHE_MAX_BYTES=21474836480

# 证书目录：<domain>.crt + <domain>.key；启动加载、热更新回写。
# 默认：./data/certs
CERT_DIR=./data/certs


# =============================================================================
# 4. WAF 质询
# =============================================================================

# 浏览器质询 nonce / clearance Cookie 的 HMAC 密钥。
# 留空时由 AGENT_TOKEN 派生；AGENT_TOKEN 也为空则进程随机（重启失效）。
# 多节点部署必须设置相同值，否则质询无法跨节点通过。
# CHALLENGE_SECRET=


# =============================================================================
# 5. 限流、CC 与 WAF 上报
# =============================================================================

# 全局默认限流 RPS/突发；域名配置为 0 时使用。
# 默认：0（不限流）
# RATE_LIMIT_RPS=0
# RATE_LIMIT_BURST=0

# 跨节点共享 CC 封禁拉取间隔（秒），代码最小 2。
# 默认：5
CC_SYNC_INTERVAL=5

# 可选 Redis，用于多 Edge 共享 CC 滑动窗口计数和普通域名 token bucket 限流。
# 留空时两者都使用进程内状态（单节点模式）。
# 生产多节点建议与控制面共用同一个 Redis，例如：
# REDIS_URL=redis://127.0.0.1:6379/0
REDIS_URL=

# CC Redis key 前缀，避免与其他业务 key 冲突。
# 默认：lagran:cc
CC_REDIS_PREFIX=lagran:cc
# Budget for one cross-node CC Redis round trip. 50ms suits a same-rack Redis;
# lower it only if an unusually slow Redis must not add latency to CC checks.
CC_REDIS_TIMEOUT_MS=50

# 普通域名限流 Redis key 前缀。
# 默认：lagran:rate
RATE_LIMIT_REDIS_PREFIX=lagran:rate

# CC 路径独立预算倍率：
# 静态资源 = 基础限额 × CC_STATIC_MULTIPLIER
# 登录/认证 = 基础限额 ÷ CC_AUTH_DIVISOR（至少 1）
# 下载/媒体 = 基础限额 × CC_DOWNLOAD_MULTIPLIER
# API 与动态页面使用基础限额。
# 默认：8 / 2 / 2
CC_STATIC_MULTIPLIER=8
CC_AUTH_DIVISOR=2
CC_DOWNLOAD_MULTIPLIER=2

# 轻量浏览器行为评分（可选）：仅对 HTML 动态/登录页面生效。
# 根据 UA、Accept-Language、Sec-CH-UA、Sec-Fetch-Mode、Cookie 等信号评分，
# 达到阈值时先返回 PoW 挑战，而不是直接封禁。
# 默认关闭，避免影响命令行/API 客户端。
CC_BEHAVIOR_ENABLED=false
CC_BEHAVIOR_SCORE=4

# 是否上报 WAF 事件到控制面。
# 默认：true
WAF_REPORT=true

# WAF 事件上报间隔（秒）。
# 默认：5
WAF_REPORT_INTERVAL=5


# =============================================================================
# 6. 源站健康检查（主备切换防抖）
# =============================================================================

# Pingora 原生回源 DNS 缓存 TTL（秒），到期后在后续请求时重新解析，钳制 1–300。
# 多个 A/AAAA 地址在请求间轮换；连接失败时依次尝试该源站的其他地址。
# 默认：30
ORIGIN_DNS_TTL_SECS=30


# 连续失败多少次后标记不健康，钳制 1–20。
# 默认：3
ORIGIN_HEALTH_FAIL_THRESHOLD=3

# 连续成功多少次后恢复健康，钳制 1–20。
# 默认：2
ORIGIN_HEALTH_RECOVER_THRESHOLD=2

# 探测间隔（秒），钳制 5–300。
# 默认：30
ORIGIN_HEALTH_INTERVAL_SECS=30

# WebSocket 隧道空闲超时（秒），钳制 10–86400。
# 双向停顿超过该时长即关闭隧道；上游若更早关闭会先行结束，不受此值影响。
# 默认：300（5 分钟）
# WEBSOCKET_IDLE_SECS=300

# 单个源站探测的总超时（秒），包含连接、响应和响应体读取，钳制 1–120。
# 超时按一次探测失败计入连续失败阈值。
# 默认：5
ORIGIN_HEALTH_TIMEOUT_SECS=5

# 每轮并发探测/上报的最大任务数，钳制 1–256。
# 默认：16
ORIGIN_HEALTH_CONCURRENCY=16


# =============================================================================
# 7. 访问日志
# =============================================================================

# 访问日志文件路径；留空只输出到 tracing。
# ACCESS_LOG_PATH=./data/access.log

# true = JSON Lines；false = 文本 combined 风格。
# 默认：false
ACCESS_LOG_JSON=false

# 内存环形缓冲条数，代码钳制 100–50000。
# 默认：2000
ACCESS_LOG_BUFFER=2000

# 是否记录访问日志。0/off/false/no 表示完全跳过日志写入。
# 默认：true
#
# 关闭后既不写文件也不进环形缓冲，管理端 /__lagran/access-logs 为空。
# 用途：区分「本来就没开日志」和「日志写入太慢拖累请求」——后者才需要排查。
# ACCESS_LOG_ENABLED=true

# 是否批量上报访问日志到 POST /api/v1/access-logs/report。
# 默认：true
ACCESS_LOG_REPORT=true

# 批量上报间隔（秒）。
# 默认：30
ACCESS_LOG_REPORT_INTERVAL=30


# =============================================================================
# 8. 反向代理与信任头
# =============================================================================

# 可信反向代理网段（逗号分隔的 IP 或 CIDR）。
#
# 只有「连接来源地址」落在这些网段内时，X-Forwarded-For / X-Forwarded-Proto
# 才会被采信；客户端 IP 从 XFF 的【最右侧】开始向左跳过可信代理，取第一个
# 非可信地址，因此客户端自己塞进最左侧的伪造值不会生效。
#
# 留空（推荐默认）：不信任任何代理，一律使用真实对端 IP，
#   客户端伪造的 XFF / X-Forwarded-Proto 会被覆盖。
#
# 示例：
#   TRUSTED_PROXIES=127.0.0.1,::1                  # 仅本机反代
#   TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16      # 内网 SLB
#   TRUSTED_PROXIES=2400:cb00::/32                 # Cloudflare 段
#
# 配置写错（非法 IP/CIDR）会直接导致 Edge 启动失败，不会静默忽略。
TRUSTED_PROXIES=

# 兼容开关：是否信任前置代理写入的 X-Forwarded-*。
# 仅在 TRUSTED_PROXIES 为空时生效，此时只有直接对端被视为可信（等于「信任
# 直接连上来的那台机器」）。新部署请改用 TRUSTED_PROXIES 精确指定网段。
# 默认：false
TRUST_PROXY_HEADERS=false


# =============================================================================
# 9. 日志
# =============================================================================

# 日志级别。指令形如 <目标>=<级别>，逗号分隔；只写级别（如 info）表示全局。
#
# 注意 lagran_edge 这个目标：它是边缘二进制自身（main.rs）的事件，启动摘要、
# 优雅关闭、CC 跨节点状态等都在这里。只配 edge=... 会把它整体过滤掉，而
# edge::cache 等库目标照常输出——看起来像"某条日志丢了"，实际是被过滤。
#
# 推荐（含二进制自身）：
RUST_LOG=lagran_edge=info,edge=info,tower_http=info
#
# 仅看库、不看主程序（不推荐，会漏掉启动与 CC 状态）：
# RUST_LOG=edge=info,tower_http=info
# 全量：RUST_LOG=debug

# 程序崩溃时输出 backtrace（可选）。
# RUST_BACKTRACE=1


# =============================================================================
# 10. 构建期变量（不需要写入运行时 EnvironmentFile）
# =============================================================================

# build.rs 优先使用 LAGRAN_GIT_HASH，其次 GITHUB_SHA，最后 git rev-parse。
# 节点心跳会上报 0.1.0+<短 hash>，控制台节点列表可见。
# LAGRAN_GIT_HASH=abc1234


# =============================================================================
# 运维提示
# =============================================================================
# - 业务健康：GET /__lagran/health
# - 配置热拉：POST /__lagran/config/reload（需 Agent 令牌）
# - 刷新缓存：POST /__lagran/purge
# - Prometheus：GET /__lagran/metrics（建议只走管理口）
# - 证书热载：POST /__lagran/certs/load
# - 管理认证头：X-Lagran-Agent-Token
# - EDGE_ADMIN_LISTEN 绝不能暴露到公网
