################################################################################
# Lagran 权威 DNS（GeoDNS）环境变量
# 应用：apps/dns  → 二进制 lagran-dns
#
# 使用方式：
#   cp dns.env.example dns.env
#   set -a && source dns.env && set +a
#   ./lagran-dns
# systemd 使用 EnvironmentFile=/etc/lagran/dns.env。
#
# 权限：绑定 53 端口通常需要 root 或 CAP_NET_BIND_SERVICE。
# 本地测试可改用 127.0.0.1:15353。
################################################################################

# =============================================================================
# 1. 监听与性能
# =============================================================================

# UDP/TCP 监听地址。
# 默认：0.0.0.0:53
DNS_LISTEN=0.0.0.0:53

# 兼容旧名，仅在 DNS_LISTEN 为空时生效。
# DNS_BIND=0.0.0.0:53

# 是否启用 TCP（大报文/截断回退）；true/false 或 1/0。
# 默认：true
DNS_TCP=true

# 工作线程数，钳制 1–64。
# 默认：8
DNS_WORKERS=8


# =============================================================================
# 2. 权威 Zone / NS / SOA
# =============================================================================

# 本服务权威的区域名（小写、无末尾点）。
# 默认：edge.lagran.net
DNS_ZONE=edge.lagran.net

# 一个或多个 NS 名称（逗号分隔），必须与父 Zone 的 NS 记录一致。
# 默认：ns1.$DNS_ZONE
DNS_NS_NAME=ns1.edge.lagran.net

# 与 DNS_NS_NAME 按顺序对应的 glue A/AAAA 记录（逗号分隔）。
# IP 数量少于 NS 名称时，重复最后一个 IP。
# 默认：127.0.0.1
DNS_NS_IP=127.0.0.1

# SOA MNAME（主 NS 名称），默认取 DNS_NS_NAME 的第一个。
# DNS_SOA_MNAME=ns1.edge.lagran.net

# SOA RNAME（管理员邮箱，用点代替 @）。
# 默认：hostmaster.$DNS_ZONE
# DNS_SOA_RNAME=hostmaster.edge.lagran.net

# A 记录 TTL（秒），钳制 5–300；最终与调度 API 返回值取较小值。
# 默认：30
DNS_TTL=30


# =============================================================================
# 3. 与控制面调度联动
# =============================================================================

# 控制面根 URL，用于请求 /api/v1/schedule。
# 默认：http://127.0.0.1:8080
CONTROL_URL=http://127.0.0.1:8080

# 调度 API 令牌，对应控制面全局 AGENT_TOKEN。
# 请求头：X-Lagran-Agent-Token
# 默认：空
AGENT_TOKEN=

# 调用控制面 HTTP 超时（毫秒）。
# 默认：800
DNS_CONTROL_TIMEOUT_MS=800


# =============================================================================
# 4. 调度结果缓存
# =============================================================================

# 新鲜缓存时间（秒），减少控制面压力。
# 默认：5
DNS_CACHE_SECS=5

# 控制面暂时不可用时，允许继续使用过期结果的最长时间（秒）。
# 默认：300
DNS_STALE_SECS=300

# 调度完全失败且无缓存时返回的兜底 A 记录。
# 留空则返回 SERVFAIL/空应答；示例：203.0.113.10
# DNS_FALLBACK_IP=


# =============================================================================
# 5. 日志
# =============================================================================

# DNS 日志至少保持 lagran_dns=info；其他 target 可自行追加。
# 示例：RUST_LOG=lagran_dns=info,info
RUST_LOG=lagran_dns=info

# 程序崩溃时输出 backtrace（可选）。
# RUST_BACKTRACE=1


# =============================================================================
# 6. 构建期变量（不需要写入运行时 EnvironmentFile）
# =============================================================================

# build.rs 优先使用 LAGRAN_GIT_HASH，其次 GITHUB_SHA，最后 git rev-parse。
# 启动日志会打印 0.1.0+<短 hash>。
# LAGRAN_GIT_HASH=abc1234


# =============================================================================
# 运维提示
# =============================================================================
# - dig @127.0.0.1 -p 53 www.example.com A
# - 客户端 ECS（EDNS0 Client Subnet）会影响地理调度结果
# - 控制面 GEOIP_PATH 必须配置正确，否则调度主要按权重/负载
# - systemd-resolved 占用 53 时，换端口或关闭 stub 监听
# - 多台 DNS 的 ZONE / NS / SOA 配置必须完全一致
