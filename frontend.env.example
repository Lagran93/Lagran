################################################################################
# Lagran 前端控制台（Nuxt）环境变量
# 应用：apps/frontend
#
# 开发：
#   cp frontend.env.example apps/frontend/.env
#   cd apps/frontend && npm ci && npm run dev
#
# 构建静态站点（本项目生产推荐）：
#   NUXT_PUBLIC_API_BASE= npm run generate
#   # 产物：apps/frontend/.output/public
#
# 重要：NUXT_PUBLIC_* 是公开变量，会进入浏览器 JS；绝不能放密钥。
################################################################################

# =============================================================================
# 1. 控制面 API 地址
# =============================================================================

# 浏览器访问控制面的根 URL，不要以 / 结尾。
#
# 开发默认（NODE_ENV=development 且未设置本变量）：
#   http://localhost:8080
#
# 生产同域反向代理（推荐）：
#   NUXT_PUBLIC_API_BASE=
#   由 Caddy/Nginx 将 /api/*、/health、/ready 转发到控制面。
#
# 生产跨域 API：
#   NUXT_PUBLIC_API_BASE=https://api.example.com
#
# 注意：该值是构建期注入（nuxt generate/build），修改后必须重新构建；
# 运行中的静态文件不会读取服务器环境变量。
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8080


# =============================================================================
# 2. 构建 / 本地运行
# =============================================================================

# Nuxt 根据 NODE_ENV 判断开发模式：
#   - development：devtools 启用，apiBase 默认 http://localhost:8080
#   - production：静态构建默认同源 API
# 通常由 npm 自动设置，不需要手动写入。
# NODE_ENV=development

# 仅 `npm run preview` 或运行 Nitro Node 服务时需要；
# `npm run generate` 的静态部署不需要。
# PORT=3000
# HOST=0.0.0.0


# =============================================================================
# 3. 与后端的对应关系
# =============================================================================

# 登录：POST {API}/api/v1/auth/login，JWT 保存在浏览器 localStorage
# 自助注册：控制面 ALLOW_REGISTER 决定是否显示注册页
# 演示账号：控制面 SEED_DEMO
# 验证码：控制面 CAPTCHA_ENABLED
# 会话失效：修改密码/管理员重置密码会递增 token_version
# 统计、实例状态、Redis 实时统计均由控制面 API 提供


# =============================================================================
# 4. 部署提示
# =============================================================================

# 1. 推荐同域部署：
#    Caddy/Nginx 托管 /opt/lagran/web（.output/public），
#    /api/*、/health、/ready 反向代理到控制面 127.0.0.1:8080。
# 2. 若前后端不同源，确认控制面 CORS/网关策略；当前代码允许任意 Origin，
#    生产仍建议同域反代。
# 3. 静态部署不需要 PORT/HOST；它们只对 preview/Node 服务有效。
# 4. NUXT_PUBLIC_API_BASE 是公开的，不要写入任何密钥。
